<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title><%= count %> последних новостей в категории <%= categoryTitle %></title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 15px;
            color: #0066cc;
            text-decoration: none;
        }
        .back-link:hover {
            text-decoration: underline;
        }
        dt {
            font-weight: bold;
            margin-top: 15px;
        }
        dd {
            margin-left: 20px;
            margin-top: 5px;
            color: #444;
        }
    </style>
</head>
<body>
    <a href="/" class="back-link">← На главную</a>
    <h3><%= count %> последних новостей в категории <%= categoryTitle %></h3>
    <dl>
        <% items.forEach(item => { %>
            <dt><%= item.title %></dt>
            <dd><%= item.description || 'Описание отсутствует' %></dd>
        <% }) %>
    </dl>
</body>
</html>
